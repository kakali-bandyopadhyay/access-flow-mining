    <ui:LogMessage DisplayName="Log Message" sap:VirtualizedContainerService.HintSize="450,166" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;Requests: &quot; &amp; dtRequests.Rows.Count.ToString &amp; &quot;, registry: &quot; &amp; dtEnt.Rows.Count.ToString &amp; &quot;, returned columns: &quot; &amp; dtReturned.Columns.Count.ToString]" />
    <ui:ForEachRow CurrentIndex="{x:Null}" DataTable="[dtRequests]" DisplayName="For Each Row in Data Table">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
          <Assign DisplayName="Reset failures">
            <Assign.To><OutArgument x:TypeArguments="scg:List(x:String)">[failures]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="scg:List(x:String)">[New List(Of String)]</InArgument></Assign.Value>
          </Assign>
          <If Condition='[String.IsNullOrWhiteSpace(row("requester_id").ToString) Or String.IsNullOrWhiteSpace(row("entitlement").ToString) Or String.IsNullOrWhiteSpace(row("line_manager_id").ToString)]' DisplayName="R1 Required fields">
            <If.Then>
              <AddToCollection x:TypeArguments="x:String" Collection="[failures]" DisplayName="Add failure" Item="R1 required field missing" />
            </If.Then>
          </If>
          <If Condition='[Not dtEnt.AsEnumerable().Any(Function(r) r("entitlement").ToString = row("entitlement").ToString)]' DisplayName="R2 Registered entitlement">
            <If.Then>
              <AddToCollection x:TypeArguments="x:String" Collection="[failures]" DisplayName="Add failure" Item="R2 entitlement not registered" />
            </If.Then>
          </If>
          <If Condition='[row("line_manager_id").ToString = row("requester_id").ToString]' DisplayName="R3 Independent manager">
            <If.Then>
              <AddToCollection x:TypeArguments="x:String" Collection="[failures]" DisplayName="Add failure" Item="R3 manager is the requester" />
            </If.Then>
          </If>
          <If Condition='[row("justification").ToString.Trim.Length &lt; 20]' DisplayName="R4 Justification length">
            <If.Then>
              <AddToCollection x:TypeArguments="x:String" Collection="[failures]" DisplayName="Add failure" Item="R4 justification under 20 characters" />
            </If.Then>
          </If>
          <If Condition='[seen.Contains(row("requester_id").ToString &amp; "|" &amp; row("entitlement").ToString)]' DisplayName="R5 Duplicate request">
            <If.Then>
              <AddToCollection x:TypeArguments="x:String" Collection="[failures]" DisplayName="Add failure" Item="R5 duplicate request" />
            </If.Then>
          </If>
          <AddToCollection x:TypeArguments="x:String" Collection="[seen]" DisplayName="Remember request" Item='[row("requester_id").ToString &amp; "|" &amp; row("entitlement").ToString]' />
          <If Condition="[failures.Count = 0]" DisplayName="Valid?">
            <If.Then>
              <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[row.ItemArray]" DataTable="[dtValid]" DisplayName="Add to valid" />
            </If.Then>
            <If.Else>
              <ui:AddDataRow DataRow="{x:Null}" ArrayRow='[row.ItemArray.Concat(New Object() {String.Join("; ", failures)}).ToArray()]' DataTable="[dtReturned]" DisplayName="Add to returned" />
            </If.Else>
          </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
