<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_to_be" targetNamespace="https://example.invalid/access-flow-synthetic" exporter="Codex draft for demo.bpmn.io" exporterVersion="1.0">
  <bpmn:process id="Process_to_be" name="Access provisioning (synthetic)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_to_be">
      <bpmn:lane id="Lane_to_be_requester" name="Requesting team">
        <bpmn:flowNodeRef>to_be_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_g7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_to_be_desk" name="Access Service Desk">
        <bpmn:flowNodeRef>to_be_bot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_bot_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_s8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_to_be_line" name="Line Management">
        <bpmn:flowNodeRef>to_be_triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_priv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_g3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_to_be_risk" name="Access Risk and Controls">
        <bpmn:flowNodeRef>to_be_s4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_to_be_owners" name="Application Owners">
        <bpmn:flowNodeRef>to_be_s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_priv2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_be_second</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_to_be_iam" name="IAM Engineering">
        <bpmn:flowNodeRef>to_be_s6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="to_be_start" name="Start" isInterrupting="true" parallelMultiple="false">
      <bpmn:outgoing>Flow_to_be_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="to_be_merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_to_be_1</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_2</bpmn:outgoing>
      <bpmn:incoming>Flow_to_be_6</bpmn:incoming>
      <bpmn:incoming>Flow_to_be_9</bpmn:incoming>
      <bpmn:incoming>Flow_to_be_15</bpmn:incoming>
      <bpmn:incoming>Flow_to_be_19</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="to_be_s1" name="1 Submit request">
      <bpmn:incoming>Flow_to_be_2</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="to_be_bot" name="Intake validation bot">
      <bpmn:incoming>Flow_to_be_3</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="to_be_bot_g" name="Valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_to_be_4</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_be_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="to_be_s2" name="2 Validate request">
      <bpmn:incoming>Flow_to_be_5</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="to_be_g2" name="Information complete?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_to_be_7</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_be_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="to_be_triage" name="Triage recommendation (model)">
      <bpmn:incoming>Flow_to_be_8</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="to_be_priv" name="Privileged?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_to_be_10</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_be_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="to_be_s3" name="3 Line manager approval">
      <bpmn:incoming>Flow_to_be_11</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="to_be_g3" name="Information complete?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_to_be_13</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_be_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="to_be_s4" name="4 SoD / access-risk check">
      <bpmn:incoming>Flow_to_be_12</bpmn:incoming>
      <bpmn:incoming>Flow_to_be_14</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="to_be_s5" name="5 Entitlement owner approval">
      <bpmn:incoming>Flow_to_be_16</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="to_be_g5" name="Information complete?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_to_be_17</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_be_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="to_be_priv2" name="Second approval required?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_to_be_18</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_be_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="to_be_second" name="Second approver confirmation">
      <bpmn:incoming>Flow_to_be_20</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="to_be_s6" name="6 Provision access">
      <bpmn:incoming>Flow_to_be_21</bpmn:incoming>
      <bpmn:incoming>Flow_to_be_22</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_23</bpmn:outgoing>
      <bpmn:incoming>Flow_to_be_26</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="to_be_s7" name="7 Confirm access works">
      <bpmn:incoming>Flow_to_be_23</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="to_be_g7" name="Access works?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_to_be_24</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_be_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="to_be_s8" name="8 Close request">
      <bpmn:incoming>Flow_to_be_25</bpmn:incoming>
      <bpmn:outgoing>Flow_to_be_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="to_be_end" name="End">
      <bpmn:incoming>Flow_to_be_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_to_be_1" sourceRef="to_be_start" targetRef="to_be_merge" />
    <bpmn:sequenceFlow id="Flow_to_be_2" sourceRef="to_be_merge" targetRef="to_be_s1" />
    <bpmn:sequenceFlow id="Flow_to_be_3" sourceRef="to_be_s1" targetRef="to_be_bot" />
