    <bpmn:sequenceFlow id="Flow_to_be_20" sourceRef="to_be_priv2" targetRef="to_be_second" name="Yes" />
    <bpmn:sequenceFlow id="Flow_to_be_21" sourceRef="to_be_priv2" targetRef="to_be_s6" name="No" />
    <bpmn:sequenceFlow id="Flow_to_be_22" sourceRef="to_be_second" targetRef="to_be_s6" />
    <bpmn:sequenceFlow id="Flow_to_be_23" sourceRef="to_be_s6" targetRef="to_be_s7" />
    <bpmn:sequenceFlow id="Flow_to_be_24" sourceRef="to_be_s7" targetRef="to_be_g7" />
    <bpmn:sequenceFlow id="Flow_to_be_25" sourceRef="to_be_g7" targetRef="to_be_s8" name="Yes" />
    <bpmn:sequenceFlow id="Flow_to_be_26" sourceRef="to_be_g7" targetRef="to_be_s6" name="No" />
    <bpmn:sequenceFlow id="Flow_to_be_27" sourceRef="to_be_s8" targetRef="to_be_end" />
    <bpmn:textAnnotation id="Annotation_to_be">
      <bpmn:text>Model recommends only; human decides; blocked attempts logged</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
