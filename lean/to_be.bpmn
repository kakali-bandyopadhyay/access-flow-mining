    <bpmn:sequenceFlow id="Flow_to_be_13" sourceRef="to_be_s3" targetRef="to_be_g3" />
    <bpmn:sequenceFlow id="Flow_to_be_14" sourceRef="to_be_g3" targetRef="to_be_s4" name="Yes" />
    <bpmn:sequenceFlow id="Flow_to_be_15" sourceRef="to_be_g3" targetRef="to_be_merge" name="No" />
    <bpmn:sequenceFlow id="Flow_to_be_16" sourceRef="to_be_s4" targetRef="to_be_s5" />
