    <bpmn:sequenceFlow id="Flow_to_be_7" sourceRef="to_be_s2" targetRef="to_be_g2" />
    <bpmn:sequenceFlow id="Flow_to_be_8" sourceRef="to_be_g2" targetRef="to_be_triage" name="Yes" />
    <bpmn:sequenceFlow id="Flow_to_be_9" sourceRef="to_be_g2" targetRef="to_be_merge" name="No" />
    <bpmn:sequenceFlow id="Flow_to_be_10" sourceRef="to_be_triage" targetRef="to_be_priv" />
    <bpmn:sequenceFlow id="Flow_to_be_11" sourceRef="to_be_priv" targetRef="to_be_s3" name="Privileged" />
