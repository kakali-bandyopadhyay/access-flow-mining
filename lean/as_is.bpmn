<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_as_is" targetNamespace="https://example.invalid/access-flow-synthetic" exporter="Codex draft for demo.bpmn.io" exporterVersion="1.0">
  <bpmn:process id="Process_as_is" name="Access provisioning (synthetic)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_as_is">
      <bpmn:lane id="Lane_as_is_requester" name="Requesting team">
        <bpmn:flowNodeRef>as_is_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as_is_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as_is_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as_is_s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as_is_g7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_as_is_desk" name="Access Service Desk">
        <bpmn:flowNodeRef>as_is_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as_is_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as_is_s8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as_is_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_as_is_line" name="Line Management">
        <bpmn:flowNodeRef>as_is_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as_is_g3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_as_is_risk" name="Access Risk and Controls">
        <bpmn:flowNodeRef>as_is_s4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_as_is_owners" name="Application Owners">
        <bpmn:flowNodeRef>as_is_s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as_is_g5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_as_is_iam" name="IAM Engineering">
        <bpmn:flowNodeRef>as_is_s6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="as_is_start" name="Start" isInterrupting="true" parallelMultiple="false">
      <bpmn:outgoing>Flow_as_is_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="as_is_merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_as_is_1</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_2</bpmn:outgoing>
      <bpmn:incoming>Flow_as_is_6</bpmn:incoming>
      <bpmn:incoming>Flow_as_is_9</bpmn:incoming>
      <bpmn:incoming>Flow_as_is_13</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="as_is_s1" name="1 Submit request">
      <bpmn:incoming>Flow_as_is_2</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="as_is_s2" name="2 Validate request">
      <bpmn:incoming>Flow_as_is_3</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="as_is_g2" name="Information complete?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_as_is_4</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_as_is_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="as_is_s3" name="3 Line manager approval">
      <bpmn:incoming>Flow_as_is_5</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="as_is_g3" name="Information complete?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_as_is_7</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_as_is_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="as_is_s4" name="4 SoD / access-risk check">
      <bpmn:incoming>Flow_as_is_8</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="as_is_s5" name="5 Entitlement owner approval">
      <bpmn:incoming>Flow_as_is_10</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="as_is_g5" name="Information complete?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_as_is_11</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_as_is_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="as_is_s6" name="6 Provision access">
      <bpmn:incoming>Flow_as_is_12</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_14</bpmn:outgoing>
      <bpmn:incoming>Flow_as_is_17</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="as_is_s7" name="7 Confirm access works">
      <bpmn:incoming>Flow_as_is_14</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="as_is_g7" name="Access works?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_as_is_15</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_as_is_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="as_is_s8" name="8 Close request">
      <bpmn:incoming>Flow_as_is_16</bpmn:incoming>
      <bpmn:outgoing>Flow_as_is_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="as_is_end" name="End">
      <bpmn:incoming>Flow_as_is_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_as_is_1" sourceRef="as_is_start" targetRef="as_is_merge" />
    <bpmn:sequenceFlow id="Flow_as_is_2" sourceRef="as_is_merge" targetRef="as_is_s1" />
    <bpmn:sequenceFlow id="Flow_as_is_3" sourceRef="as_is_s1" targetRef="as_is_s2" />
    <bpmn:sequenceFlow id="Flow_as_is_4" sourceRef="as_is_s2" targetRef="as_is_g2" />
    <bpmn:sequenceFlow id="Flow_as_is_5" sourceRef="as_is_g2" targetRef="as_is_s3" name="Yes" />
    <bpmn:sequenceFlow id="Flow_as_is_6" sourceRef="as_is_g2" targetRef="as_is_merge" name="No" />
    <bpmn:sequenceFlow id="Flow_as_is_7" sourceRef="as_is_s3" targetRef="as_is_g3" />
    <bpmn:sequenceFlow id="Flow_as_is_8" sourceRef="as_is_g3" targetRef="as_is_s4" name="Yes" />
    <bpmn:sequenceFlow id="Flow_as_is_9" sourceRef="as_is_g3" targetRef="as_is_merge" name="No" />
    <bpmn:sequenceFlow id="Flow_as_is_10" sourceRef="as_is_s4" targetRef="as_is_s5" />
    <bpmn:sequenceFlow id="Flow_as_is_11" sourceRef="as_is_s5" targetRef="as_is_g5" />
    <bpmn:sequenceFlow id="Flow_as_is_12" sourceRef="as_is_g5" targetRef="as_is_s6" name="Yes" />
    <bpmn:sequenceFlow id="Flow_as_is_13" sourceRef="as_is_g5" targetRef="as_is_merge" name="No" />
    <bpmn:sequenceFlow id="Flow_as_is_14" sourceRef="as_is_s6" targetRef="as_is_s7" />
    <bpmn:sequenceFlow id="Flow_as_is_15" sourceRef="as_is_s7" targetRef="as_is_g7" />
    <bpmn:sequenceFlow id="Flow_as_is_16" sourceRef="as_is_g7" targetRef="as_is_s8" name="Yes" />
    <bpmn:sequenceFlow id="Flow_as_is_17" sourceRef="as_is_g7" targetRef="as_is_s6" name="No" />
    <bpmn:sequenceFlow id="Flow_as_is_18" sourceRef="as_is_s8" targetRef="as_is_end" />
  </bpmn:process>
